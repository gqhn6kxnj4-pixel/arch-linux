{
  "layer": "top",
  "position": "top",

  "modules-left": [
    "hyprland/workspaces",
    "custom/active-app"
  ],

  "modules-center": [
    "custom/net-speed",
    "clock"
  ],

  "modules-right": [
    "custom/gpu-temp",
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "custom/updates",
    "custom/battery",
    "custom/bluetooth",
    "custom/power"
  ],

  "custom/active-app": {
   "exec": "~/.config/waybar/scripts/active-app.sh",
   "return-type": "json",
   "interval": 1,
   "tooltip": false
  },
  
  "custom/gpu-temp": {
   "exec": "~/.config/waybar/scripts/gpu-temp.sh",
   "return-type": "json",
   "interval": 2,
   "tooltip": false
  },

  "clock": {
    "format": "{:%a %d %b %H:%M 󰃰}",
    "interval": 30,
    "tooltip": true,
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "kitty -e calcurse"
  },

  "custom/net-speed": {
    "exec": "~/.config/waybar/scripts/net-speed.sh",
    "return-type": "json",
    "interval": 1,
    "tooltip": false
  },

  "cpu": {
   "format": "{usage}% ",
   "interval": 2
  },

  "memory": {
   "format": "{percentage}% 󰍛",
   "interval": 5
  },

  "network": {
    "format-wifi": " {essid} ({signalStrength}%)",
    "format-ethernet": "󰈀 ETH",
    "format-disconnected": "󰤭 OFF",
    "on-click": "kitty -e nmtui",
    "tooltip": true,
    "interval": 3
  },

  "pulseaudio": {
    "format": "{volume}% 󰕾",
    "format-muted": "󰖁",
    "scroll-step": 5,
    "on-click": "~/.config/waybar/scripts/open-audio-effects.sh"
  },

  "custom/bluetooth": {
    "exec": "~/.config/waybar/scripts/bluetooth.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "blueman-manager",
    "tooltip": false
  },

  "custom/battery": {
    "exec": "~/.config/waybar/scripts/battery.sh",
    "return-type": "json",
    "interval": 10,
    "tooltip": false
  },

  "custom/power": {
    "format": "",
    "on-click": "systemctl poweroff"
  }
}
